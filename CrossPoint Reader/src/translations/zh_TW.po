msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: zh_TW\n"

msgid " s"
msgstr " 秒"

msgid "Enable debug logging"
msgstr "啟用偵錯記錄"

msgid "Fetch metadata for side-loaded books (downloads each once on connect)"
msgstr "讀取自行放入書籍的中繼資料（連線時各下載一次）"

msgid "Send to root (ignore any template)"
msgstr "傳送到根目錄（忽略範本）"

msgid "Overwrite file if it already exists on the device"
msgstr "覆蓋閱讀器上已存在的同名檔案"

msgid "Optimize EPUBs before transfer"
msgstr "傳輸前最佳化 EPUB"

msgid "Convert images to grayscale"
msgstr "將圖片轉為灰階"

msgid "Auto-crop uniform margins"
msgstr "自動裁切一致的邊白"

msgid "Split large chapters/paragraphs, remove fonts (prevents out-of-memory)"
msgstr "分割大型章節／段落並移除字型（避免記憶體不足）"

msgid "Auto-detect"
msgstr "自動偵測"

msgid "X4 (480×800)"
msgstr "X4（480×800）"

msgid "X3 (528×792)"
msgstr "X3（528×792）"

msgid "Leave blank to use Calibre's send-to-device template"
msgstr "留白時使用 calibre 的傳送到裝置範本"

msgid "Host"
msgstr "主機"

msgid "Port"
msgstr "連接埠"

msgid "Host and port settings are fallback values used only when the device is not auto-discoverable by UDP broadcast."
msgstr "主機與連接埠用於探索時的備援目標；必須確認閱讀器檔案服務可用才會連線。"

msgid "Upload path"
msgstr "上傳路徑"

msgid "Upload template"
msgstr "上傳範本"

msgid "Chunk size"
msgstr "傳輸區塊大小"

msgid "<b>Upload reliability</b>"
msgstr "<b>傳輸穩定性</b>"

msgid "Retries resend the current book from the beginning after transient WebSocket failures."
msgstr "WebSocket 暫時失敗後，會從頭重新傳送目前書籍。"

msgid "Upload retries"
msgstr "上傳重試次數"

msgid "Retry delay"
msgstr "重試間隔"

msgid "Delay between books"
msgstr "書籍間的等候時間"

msgid "Socket timeout"
msgstr "連線逾時"

msgid "<b>Optimizer</b>"
msgstr "<b>最佳化</b>"

msgid "Mirrors the CrossPoint web optimizer: resizes images to the screen, converts to grayscale and re-encodes as JPEG, then rewrites the EPUB. A summary is shown after each transfer."
msgstr "沿用 CrossPoint 網頁最佳化器：依螢幕縮放圖片、轉成灰階並重編碼為 JPEG，再重建 EPUB。傳輸完成後會顯示摘要。"

msgid "Device target"
msgstr "目標裝置"

msgid "JPEG quality"
msgstr "JPEG 品質"

msgid "Discovery log will appear here when debug is enabled."
msgstr "啟用偵錯後，這裡會顯示裝置探索記錄。"

msgid "Refresh Log"
msgstr "重新整理記錄"

msgid "Log"
msgstr "記錄"

